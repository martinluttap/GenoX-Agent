docker {
    enabled = true
}

trace {
    enabled = true
    overwrite = true
    fields = 'task_id,hash,native_id,process,tag,name,status,exit,module,container,cpus,time,disk,memory,attempt,submit,start,complete,duration,realtime,queue,%cpu,%mem,rss,vmem,peak_rss,peak_vmem,rchar,wchar,syscr,syscw,read_bytes,write_bytes,vol_ctxt,inv_ctxt,env,workdir,scratch,error_action,hostname,cpu_model'
    raw = true
    sep = ','
}
report.overwrite = true
timeline.overwrite = true

process {
    withName: GATK4_BASERECALIBRATOR {
        containerOptions = "--entrypoint ''"
    }
    withName: GATK4_BASERECALIBRATOR_SPARK {
        containerOptions = "--entrypoint ''"
    }
    withName: GATK4_BASERECALIBRATOR_SPARK_16c {
        containerOptions = "--entrypoint ''"
    }
    withName: GATK4_BASERECALIBRATOR_SPARK_8c {
        containerOptions = "--entrypoint ''"
    }
    withName: GATK4_BASERECALIBRATOR_SPARK_4c {
        containerOptions = "--entrypoint ''"
    }
}

